@baseUrl = http://localhost:5275

### Get All
GET {{baseUrl}}/api/videogames

### Get by ID
GET {{baseUrl}}/api/videogames/1

### Create videogame
POST {{baseUrl}}/api/videogames
Content-Type: application/json

{
  "id": 4,
  "title": "Celeste",
  "genre": "Platformer",
  "releaseYear": 2018
}

### Update videogame
PUT {{baseUrl}}/api/videogames/4
Content-Type: application/json

{
  "id": 4,
  "title": "Celeste",
  "genre": "Platformer",
  "releaseYear": 2018
}

### Delete videogame
DELETE {{baseUrl}}/api/videogames/4




### Empty title: return 400
POST {{baseUrl}}/api/videogames
Content-Type: application/json

{
  "id": 10,
  "title": "",
  "genre": "RPG",
  "releaseYear": 2020
}

### Year not valid: return 400
POST {{baseUrl}}/api/videogames
Content-Type: application/json

{
  "id": 11,
  "title": "Mi juego",
  "genre": "RPG",
  "releaseYear": 1800
}

### Valid values: return 201
POST {{baseUrl}}/api/videogames
Content-Type: application/json

{
  "id": 12,
  "title": "Hades",
  "genre": "Roguelike",
  "releaseYear": 2020
}
